# What is not sent to the Docker build. Patterns start with / so that they only match the project root.

# Version control and editors
/.git
/.github
/.gitignore
/.vscode

# Local configuration and secrets must never end up in an image
/.env
/.env.*
/.cdsrc-private.json
/default-*.json
/connection.properties

# Installed and generated by the build
**/node_modules
/gen
/@cds-models
/_out
/mta_archives
**/*.mtar
**/*.db
**/*.sqlite
**/*.log
/.cds-msg-box*

# Not needed to build or run the server
/test
/http
/scripts
/docs
/coverage
/mta.yaml
/xs-security.json
/jsconfig.json
/eslint.config.mjs
/README.md
