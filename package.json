{
  "name": "Benicio_1_04",
  "version": "1.0.0",
  "description": "Customer Messages application built with SAP CAP, enriching incoming messages with GenAI (translation, summary, category, urgency, sentiment).",
  "keywords": [
    "sap",
    "cap",
    "cds",
    "odata",
    "fiori",
    "genai",
    "sap-ai-sdk"
  ],
  "homepage": "https://github.com/brunofbenicio/SapCapWorkShop#readme",
  "bugs": {
    "url": "https://github.com/brunofbenicio/SapCapWorkShop/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brunofbenicio/SapCapWorkShop.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/audit-logging": "^1.3.0",
    "@cap-js/change-tracking": "^2.2.3",
    "@cap-js/graphql": "^0.14.0",
    "@cap-js/hana": "^2",
    "@sap-ai-sdk/foundation-models": "^1.15.0",
    "@sap-ai-sdk/orchestration": "^1.15.0",
    "@sap-cloud-sdk/connectivity": "^4.0.2",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap-cloud-sdk/resilience": "^4.0.2",
    "@sap-cloud-sdk/util": "^4.0.2",
    "@sap/cds": "^9",
    "@sap/cds-mtxs": "^4.1.1",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": "^6",
    "@sap/xssec": "^4.8.0",
    "express": "^4",
    "hdb": "^2.25.1",
    "passport": "^0.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "devDependencies": {
    "@cap-js/asyncapi": "^1.1.0",
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.11.0",
    "@cap-js/openapi": "^1.7.0",
    "@cap-js/sqlite": "^2",
    "@cap-js/telemetry": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "openapi": "node scripts/openapi.js",
    "asyncapi": "cds compile srv --service all --to asyncapi -o docs/asyncapi",
    "types": "cds-typer \"*\"",
    "typecheck": "tsc -p jsconfig.json",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-benicio_1_04.myapplication": "cds watch --open benicio_1_04.myapplication/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "messaging": {
        "[development]": {
          "kind": "file-based-messaging",
          "file": ".cds-msg-box"
        },
        "[test]": {
          "kind": "local-messaging"
        },
        "[production]": {
          "kind": "local-messaging"
        }
      },
      "queue": {
        "chunkSize": 3
      },
      "audit-log": {
        "[test]": {
          "impl": "test/helpers/audit-log-recorder.js"
        }
      },
      "telemetry": {
        "[development]": {
          "kind": "telemetry-to-console"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "viewer": {
              "password": "viewer",
              "roles": [
                "Viewer"
              ]
            },
            "agent": {
              "password": "agent",
              "roles": [
                "Viewer",
                "Agent"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "Viewer",
                "Agent",
                "Admin"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        },
        "[multitenancy]": {
          "users": {
            "t1-agent": {
              "password": "agent",
              "tenant": "t1",
              "roles": [
                "Viewer",
                "Agent"
              ]
            },
            "t2-agent": {
              "password": "agent",
              "tenant": "t2",
              "roles": [
                "Viewer",
                "Agent"
              ]
            },
            "t1-developer": {
              "password": "developer",
              "tenant": "t1",
              "roles": [
                "Viewer",
                "cds.ExtensionDeveloper"
              ]
            }
          },
          "tenants": {
            "t1": {
              "features": []
            },
            "t2": {
              "features": [
                "internal-note"
              ]
            }
          }
        }
      },
      "S4HCP_ServiceOrder_Odata": {
        "kind": "odata-v2",
        "model": "srv/external/S4HCP_ServiceOrder_Odata",
        "[production]": {
          "credentials": {
            "destination": "S4HCP-ServiceOrder-Odata"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      },
      "[multitenancy]": {
        "multitenancy": true,
        "extensibility": {
          "[development]": {
            "tenantCheckInterval": 500
          }
        },
        "toggles": true,
        "cds.xt.ExtensibilityService": {
          "element-prefix": [
            "x_"
          ],
          "extension-allowlist": [
            {
              "for": [
                "Benicio_1_04.CustomerMessages"
              ],
              "kind": "entity",
              "new-fields": 3
            }
          ]
        }
      }
    },
    "genai": {
      "[test]": {
        "enabled": false
      }
    },
    "server": {
      "cors": false
    },
    "cors": {
      "origins": [],
      "[development]": {
        "origins": [
          "*"
        ]
      }
    },
    "protocols": {
      "graphql": {
        "[production]": {
          "graphiql": false
        }
      }
    },
    "export": {
      "asyncapi": {
        "application_namespace": "customer.customermessages"
      }
    },
    "typer": {
      "outputDirectory": "@cds-models",
      "buildTask": false
    }
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/gen/"
    ]
  },
  "lcap": true,
  "sapux": [
    "app/benicio_1_04.myapplication"
  ]
}
