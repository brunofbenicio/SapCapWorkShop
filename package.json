{
  "name": "Benicio_1_04",
  "version": "1.0.0",
  "description": "Customer Messages application built with SAP CAP, enriching incoming messages with GenAI (translation, summary, category, urgency, sentiment).",
  "keywords": [
    "sap",
    "cap",
    "cds",
    "odata",
    "fiori",
    "genai",
    "sap-ai-sdk"
  ],
  "homepage": "https://github.com/brunofbenicio/SapCapWorkShop#readme",
  "bugs": {
    "url": "https://github.com/brunofbenicio/SapCapWorkShop/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brunofbenicio/SapCapWorkShop.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-ai-sdk/foundation-models": "^1.15.0",
    "@sap-ai-sdk/orchestration": "^1.15.0",
    "@sap-cloud-sdk/connectivity": "^4.0.2",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap-cloud-sdk/resilience": "^4.0.2",
    "@sap-cloud-sdk/util": "^4.0.2",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": "^6",
    "@sap/xssec": "^4.8.0",
    "express": "^4",
    "hdb": "^2.25.1",
    "passport": "^0.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.11.0",
    "@cap-js/sqlite": "^2",
    "@eslint/js": "^9.39.5",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "eslint": "^9.39.5",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-benicio_1_04.myapplication": "cds watch --open benicio_1_04.myapplication/webapp/index.html?sap-ui-xx-viewCache=false"
  },
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "S4HCP_ServiceOrder_Odata": {
        "kind": "odata-v2",
        "model": "srv/external/S4HCP_ServiceOrder_Odata",
        "[production]": {
          "credentials": {
            "destination": "S4HCP-ServiceOrder-Odata"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      }
    }
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/gen/"
    ]
  },
  "lcap": true,
  "sapux": [
    "app/benicio_1_04.myapplication"
  ]
}
